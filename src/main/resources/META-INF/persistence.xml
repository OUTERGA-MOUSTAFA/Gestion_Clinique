<?xml version="1.0" encoding="UTF-8"?>

<!--
    Configuration de JPA.

    Ce fichier indique à Hibernate :
    - quelle base de données utiliser
    - quel driver utiliser
    - quelles entités Java gérer
-->

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
                https://jakarta.ee/xml/ns/persistence
                https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">


    <!--
        Une persistence-unit représente une unité de travail JPA.

        Le nom "cliniquePU" sera utilisé dans Java :

        Persistence.createEntityManagerFactory("cliniquePU")
    -->

    <persistence-unit name="cliniquePU"
                      transaction-type="RESOURCE_LOCAL">


        <!--
            Hibernate est notre provider JPA.
        -->

        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>


        <!--
            Liste des entités JPA.

            On ajoutera ici les classes qui représentent
            les tables de la base de données.
        -->

        <class>com.clinique.gestion_clinique.api.model.Utilisateur</class>

        <class>com.clinique.gestion_clinique.api.model.DemandeExpertise</class>

        <class>com.clinique.gestion_clinique.api.model.Specialite</class>
        <!--
            Configuration de connexion MySQL.
        -->

        <properties>


            <!-- URL de la base de données -->

            <property
                name="jakarta.persistence.jdbc.url"
                value="jdbc:mysql://localhost:3306/gestion_clinique?useSSL=false&amp;serverTimezone=UTC"/>


            <!-- Utilisateur MySQL -->

            <property
                name="jakarta.persistence.jdbc.user"
                value="root"/>


            <!-- Mot de passe MySQL -->

            <property
                name="jakarta.persistence.jdbc.password"
                value=""/>


            <!-- Driver MySQL -->

            <property
                name="jakarta.persistence.jdbc.driver"
                value="com.mysql.cj.jdbc.Driver"/>


            <!--
                Hibernate crée / met à jour les tables
                correspondant aux entités.

                En développement seulement.
            -->

            <property
                name="hibernate.hbm2ddl.auto"
                value="update"/>


            <!-- Afficher les requêtes SQL dans la console -->

            <property
                name="hibernate.show_sql"
                value="true"/>


            <!-- Afficher un SQL plus lisible -->

            <property
                name="hibernate.format_sql"
                value="true"/>


        </properties>

    </persistence-unit>

</persistence>